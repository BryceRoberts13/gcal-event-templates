{
  "manifest_version": 3,
  "name": "Google Calendar Event Templates",
  "version": "0.4.1",
  "description": "Hide individual events from the calendar grid, and show them again from the left sidebar. Also searchable event templates.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://calendar.google.com/*"],
  "action": {
    "default_title": "Event Templates",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["src/content/main.ts"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
